; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Punch your Enemy"
config/description="Ein alberner Slapstick-Clicker: Fäuste statt Kekse."
config/version="0.7.1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="PunchYourEnemy"

[autoload]

GameState="*res://scripts/core/game_state.gd"
Sfx="*res://scripts/audio/sfx.gd"
SteamService="*res://scripts/core/steam_service.gd"
Music="*res://scripts/audio/music.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[internationalization]

locale/fallback="de"
locale/translations=PackedStringArray("res://locale/en.po")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[steam]

app_id=480
